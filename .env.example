# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# On Streamlit Community Cloud these go in the app's Secrets box (Manage app ->
# Settings -> Secrets), in TOML form: KEY = "value". Streamlit exposes them to
# the process as environment variables, which is where the app reads them.
# The app does not read a .env at all when it detects it is running in public.

# Free tier. Serves the public demo's LLM calls. https://console.groq.com/keys
GROQ_API_KEY=

# Free tier. Embeds queries against the shipped index, and is a second free
# LLM provider. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional, paid. Only used locally, to build the text-embedding-3-large index
# for the embedding benchmark. Never deployed - see DEPLOY.md.
OPENAI_API_KEY=

# Optional, paid. Available as a bring-your-own-key model in the UI.
DEEPSEEK_API_KEY=
